{
  "name": "outbox-connector",
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "database.hostname": "mysql",
  "database.port": "3306",
  "database.user": "debezium",
  "database.password": "debezium_pw",
  "database.server.id": "184054",
  "topic.prefix": "msa",
  "database.include.list": "inventory_db,shipping_db",
  "table.include.list": "inventory_db.outbox,shipping_db.outbox",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:19092",
  "schema.history.internal.kafka.topic": "msa.schema-history",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.field.event.key": "order_id",
  "transforms.outbox.table.fields.additional.placement": "type:header:__TypeId__",
  "transforms.outbox.table.expand.json.payload": "true"
}
